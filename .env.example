# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY=cole_a_chave_web_do_firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=cole_a_site_key_publica
TURNSTILE_SECRET_KEY=cole_a_secret_key_privada

# Firebase Admin — mantenha estes valores somente no servidor
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Integração com o ESP32 (servidor de voz do PC) — rota app/api/esp/comando
# Segredo compartilhado (mínimo 24 caracteres): igual a SITE_COMANDO_TOKEN no .env do servidor de voz
ESP32_SITE_TOKEN=
# E-mail da conta que recebe as vendas e entradas de estoque feitas por voz
ESP32_EMPRESA_EMAIL=
